---
// 带箭头标注的截图：<Annot src="quick-number/zh-1-page.jpg" w={460} h={300} alt="…" marks={[…]} />
// 图在 public/img/。marks 的坐标就是图片自己的像素（SVG 的 viewBox 和图一样大），图缩放时标注跟着缩。
//   { box: [x, y, w, h], n?: 1, label?: "填码" }        圈出一块，编号和说明贴在框的左上角
//   { arrow: [x1, y1, x2, y2], n?: 2, label?: "点这里", bend?: 0.22 }
//                                                     从 (x1,y1) 指到 (x2,y2)，编号和说明接在箭尾，往远离箭头的那边排开
//   两种都可以加 at: [x, y]（编号圆点的起点）和 dir: 1 | -1（往右 / 往左排），自己放编号，避开截图里的字
// 截图永远是亮色的，所以标注用固定的红色，外面一圈白边，暗色主题下也看得清。
// 进入视野后按顺序画出来；系统设了减少动效、或者没有脚本时直接显示完整的标注。
import { link, langOf } from "../data/nav.js";
interface Mark { box?: number[]; arrow?: number[]; n?: number; label?: string; bend?: number; at?: number[]; dir?: number }
interface Props { src: string; alt: string; w: number; h: number; marks: Mark[]; caption?: string; date?: string }
const { src, alt, w, h, marks, caption, date = "2026-11" } = Astro.props;
const en = langOf(Astro.url.pathname) === "en";
const stamp = en ? `Screenshot ${date}; the page may have changed since.` : `截图于 ${date}，页面以实际为准。`;

const r = (v: number) => Math.round(v * 10) / 10;
// 宽的截图在手机上缩得更小，编号和字按图宽放大一点，缩完以后大小差不多
const k = Math.max(1, w / 460);
const BADGE = Math.round(13 * k);
// 编号圆点和说明：从 (x, y) 起往 dir 方向排（1 往右，-1 往左）
const tagAt = (x: number, y: number, dir: number, n?: number, label?: string) => {
  const bx = x + dir * BADGE;
  return { n, label, bx, by: y, lx: bx + dir * (BADGE + 6), anchor: dir > 0 ? "start" : "end" };
};
const items = marks.map((m, i) => {
  if (m.box) {
    const [x, y, bw, bh] = m.box;
    return { i, kind: "box", x, y, bw, bh, tag: m.at ? tagAt(m.at[0], m.at[1], m.dir ?? 1, m.n, m.label) : tagAt(x - 4, y - BADGE - 4, 1, m.n, m.label) };
  }
  const [x1, y1, x2, y2] = m.arrow!;
  const dx = x2 - x1, dy = y2 - y1, len = Math.hypot(dx, dy);
  const bend = m.bend ?? 0.22;
  // 控制点：线段中点往一侧偏一点，箭头带一点弧度，像手画的
  const cx = (x1 + x2) / 2 - (dy / len) * len * bend, cy = (y1 + y2) / 2 + (dx / len) * len * bend;
  // 箭头方向：从控制点指向终点
  const ax = x2 - cx, ay = y2 - cy, al = Math.hypot(ax, ay), ux = ax / al, uy = ay / al;
  const H = 15 * k, W = 8 * k;
  const head = [[x2, y2], [x2 - ux * H - uy * W, y2 - uy * H + ux * W], [x2 - ux * H + uy * W, y2 - uy * H - ux * W]].map((p) => p.map(r).join(",")).join(" ");
  const dir = dx > 0 ? -1 : 1;
  return { i, kind: "arrow", d: `M${r(x1)} ${r(y1)} Q${r(cx)} ${r(cy)} ${r(x2)} ${r(y2)}`, head, tag: m.at ? tagAt(m.at[0], m.at[1], m.dir ?? dir, m.n, m.label) : tagAt(x1 + dir * 4, y1, dir, m.n, m.label) };
});
---
<figure class="shot annot">
  <div class="annot__frame">
    <img src={link(`/img/${src}`)} alt={alt} width={w} height={h} loading="lazy" decoding="async" />
    <svg class="annot__svg" viewBox={`0 0 ${w} ${h}`} style={`--k:${k.toFixed(2)}`} aria-hidden="true">
      {items.map((it) => (
        <g class="annot__mark" style={`--i:${it.i}`}>
          {it.kind === "box" ? (
            <>
              <rect class="annot__halo" x={it.x} y={it.y} width={it.bw} height={it.bh} rx="8" pathLength="1" />
              <rect class="annot__line" x={it.x} y={it.y} width={it.bw} height={it.bh} rx="8" pathLength="1" />
            </>
          ) : (
            <>
              <path class="annot__halo" d={it.d} pathLength="1" />
              <path class="annot__line" d={it.d} pathLength="1" />
              <polygon class="annot__head" points={it.head} />
            </>
          )}
          {it.tag.n && (
            <g class="annot__tag">
              <circle cx={it.tag.bx} cy={it.tag.by} r={BADGE} />
              <text class="annot__no" x={it.tag.bx} y={it.tag.by} text-anchor="middle" dominant-baseline="central">{it.tag.n}</text>
              {it.tag.label && <text class="annot__label" x={it.tag.lx} y={it.tag.by} text-anchor={it.tag.anchor} dominant-baseline="central">{it.tag.label}</text>}
            </g>
          )}
        </g>
      ))}
    </svg>
  </div>
  <figcaption>{caption && <span>{caption}</span>} <span class="shot__stamp">{stamp}</span></figcaption>
</figure>

<script>
  // 进入视野时按顺序把标注画出来，只画一次
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  if (!reduce.matches && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
    }, { threshold: 0.5 });
    for (const f of document.querySelectorAll<HTMLElement>(".annot")) { f.classList.add("is-anim"); io.observe(f); }
  }
</script>
