---
// 中文、英文首页。大多数读者来这里，不是为了出国，是要一个美国 +1 号码去注册海外应用、收验证码，所以首页围着这件事讲：
// 卡在哪（痛点）→ 和接码平台差在哪 → 从买号到收码的六步（ROUTE）→ 能收哪些码、哪些别指望 → 适不适合 → 网站还讲什么（流量放最后）。
// Saily 的事实出自官方帮助中心；网友的经验写明是网友，附原帖（来源见 docs/sources/README.md）。
// 以后加的语言（日韩西葡法德俄阿）还是原来那张以出国上网为主的首页：views/HomeIntl.astro。
import Site from "../layouts/Site.astro";
import Contact from "../components/Contact.astro";
import { ROUTE, routeHref, LESSONS, lessonHref, STEPS, stepHref, langOf, t, link } from "../data/nav.js";

const lang = langOf(Astro.url.pathname) === "en" ? "en" : "zh";
// 官方文章写全地址（check-doc-links 只认完整的链接）：[中文版, 英文版]
const DOC = {
  otp: ["https://support.saily.com/hc/zh-cn/articles/27948689277596", "https://support.saily.com/hc/en-us/articles/27948689277596"],
  keep: ["https://support.saily.com/hc/zh-cn/articles/31089593239452", "https://support.saily.com/hc/en-us/articles/31089593239452"],
};
const doc = (k: keyof typeof DOC) => DOC[k][lang === "en" ? 1 : 0];
const a = (href: string, text: string) => `<a class="xxd-link" href="${href}">${text}</a>`;
const L = (p: string) => link(p, lang);
const POST_TAKEOVER = "https://www.80aj.com/2026/08/26/whatsapp-account-loss-risk/";
const POST_JASON = "https://x.com/AI_Jasonyu/status/2080877134319624492";

const ZH = {
  brand: "Saily 新手教程",
  h1: "一个只归你的美国 +1 号码，拿去注册、收验证码",
  lead: ["很多海外应用注册、登录都要验证手机号，+86 号码常常收不到码。Saily 是 Nord Security（做 NordVPN 的那家公司）出的 eSIM，它另外卖一个美国 +1 号码：按北美号码计划分配，只要服务一直有效，就只归你一个人用，能收验证码、发短信、打电话。不用先买流量，网页上就能单独买。", "这是一个非官方的学习站", "，和 Saily、Nord Security 都没有关系；功能和价格以官方帮助中心和 App 为准。"],
  cta: ["极速拿号：网页上 3 分钟买好", "先弄懂这个号码"],
  ctaNote: "买完要在 Saily App 里实名，才会分到号码；号码装在 eSIM 上，手机不支持 eSIM 也有办法。",
  painH: "你是不是也卡在这些地方",
  PAIN: [
    "注册 Telegram、WhatsApp 这类海外应用，填上 +86 号码，验证码迟迟不来，或者干脆提示不支持这个号码。",
    `在接码平台上花几块钱收了个码，号码却不是你的。过一阵它转给了别人，别人拿同一个号码，就能把你的账号重新注册走（${a(POST_TAKEOVER, "一个真实的例子")}）。`,
    "账号绑的号码停了、过期了，换手机登录时验证码发不到你手里，账号就这样找不回来。",
    `想办一张国外的手机卡，月租不便宜，开通流程也越来越难走，有网友办美国卡就卡在了注册那一步（${a(POST_JASON, "原帖")}）。`,
    "好不容易有了美国号码，绑上去才发现有的应用不发码，又分不清是号码不行，还是手机没收到。",
  ],
  vsH: "它和接码平台差在哪",
  vsP: "接码平台的号码是租来的，Saily 的号码是你自己的。要长期用、以后还要靠它找回的账号，差别就在这里。",
  vsHead: ["", "接码平台", "Saily 美国号码"],
  VS: [
    ["号码归谁", "平台的。同一个号码，过一阵就给下一个人收码", `只要服务一直有效，只分给你一个人用（${a(doc("otp"), "官方说明")}）`],
    ["过半年还能收码吗", "多半不能，号码早就转给别人了", `续费不断就一直在；停了续费还留 30 天，能接回来（${a(doc("keep"), "官方说明")}）`],
    ["要准备什么", "不用实名，按次付钱", "要实名认证，号码按周期续费，还要一台能装 eSIM 的设备"],
  ],
  routeH: "从买号到收码，六步",
  routeP: "按顺序走，每一步都链到细讲的那一页。整个过程在网页和 Saily App 里做，不用出国。",
  routeLabel: "拿美国号码：共 6 步",
  codesH: "说清楚：哪些码收得到",
  codesP: "号码是真的美国号码，可提供号码的运营商走网络电话（VoIP）的线路，所以有些会查号码类型的服务把它认成 VoIP，不发码。官方直说了这一点，下面按把握从大到小排：",
  CODES: [
    ["官方名单：通常收得到", `一次性验证码：WhatsApp、Signal、Viber、Airbnb；两步验证：PayPal、Wise、Venmo 等。名单不完整，也不保证（${a(doc("otp"), "官方清单")}）`],
    ["网友实测：结果不一", `Telegram、X、Google、Apple ID、ChatGPT……同一个应用，有人收到、有人没收到，详见${a(L("/howto/number-apps/"), "美国号码能用在哪些应用")}`],
    ["人在中国大陆", `网友在国内收到过验证码，走的是当地的漫游网络（${a(POST_JASON, "原帖")}）；可官方英文版的通话名单里没有中国大陆，打电话不一定行`],
    ["别指望", "银行、券商这类金融服务：官方说有的不收这类号码。这个号码也不等于你在美国有了身份，本站不讲拿它开户"],
  ],
  fitH: "适不适合你", yesH: "适合", noH: "先不用",
  YES: ["要注册、登录海外应用，需要一个能收短信验证码的号码", "账号要长期用，想要一个只归自己、能一直续着的号码", "能用有效证件做实名：中国签发的证件，护照和身份证两样都要", "手机支持 eSIM，或者愿意配一张能写入 eSIM 的实体卡"],
  NO: ["要拿它绑美国的银行、券商或支付账户做验证", "要用彩信或呼叫转移：这个号码不支持", "证件是 Saily 目前验证不了的国家签发的，比如俄罗斯、伊朗、朝鲜", "不想按期续费：号码要一直续着才留得住"],
  tracksH: "这个网站还讲什么",
  tracksP: "号码以外，Saily 的本行是出国用的流量。用得上的时候，完整教程里都有。",
  TRACKS: [
    ["PhoneCall", "美国 +1 号码", "实名要哪些证件，验证码收不到怎么办，接电话也扣分钟，短信只发纯文字，号码怎么留住、怎么换。", [5]],
    ["Smartphone", "手机不支持 eSIM", "国行手机多半没有 eSIM。官方的办法是一张能写入 eSIM 的实体卡：插进卡槽，再把 Saily 装上去。", [6]],
    ["Globe", "出国上网的流量", "按目的地买流量套餐，装进手机，落地就能用。第一次用的话，新手入门三课一条路走到底。", [0, 1, 2, 3, 4, 7]],
  ],
  lessonsLink: "出国上网：新手三课",
  tracksLabel: "完整教程里对应的步骤",
  stepLink: (n: number, title: string) => `第 ${n} 步：${title}`,
};

const EN: typeof ZH = {
  brand: "Saily for beginners",
  h1: "A +1 US number of your own, for sign-ups and verification codes",
  lead: ["Lots of apps want to verify a phone number when you sign up or log in, and plenty of numbers from outside the US never get the code. Saily, an eSIM from Nord Security (the company behind NordVPN), also sells a +1 US number. It's assigned under the North American Numbering Plan and, as long as your service stays active, it's yours alone, for verification codes, texts and calls. You don't need a data plan first, and you can buy it on the website. ", "This is an unofficial guide", ", not affiliated with Saily or Nord Security. For features and prices, the official Help Center and the app are the source of truth."],
  cta: ["Quick number: buy one on the website in 3 minutes", "Understand the number first"],
  ctaNote: "After you pay, you verify your identity in the Saily app before the number is assigned. The number lives on an eSIM, and there's a way even if your phone has none.",
  painH: "Stuck on any of these?",
  PAIN: [
    "You sign up for an app like Telegram or WhatsApp, enter your home number, and the code never comes, or the app says it doesn't accept that number.",
    `You paid a code-receiving site a little for a code, but the number was never yours. Later it went to someone else, who used the same number to sign up again and take your account (${a(POST_TAKEOVER, "a real case, in Chinese")}).`,
    "The number on your account was cancelled or expired, so when you log in on a new phone the code goes nowhere and the account is gone.",
    `You looked at getting a SIM from another country, but the monthly fee isn't small and signing up keeps getting harder. One user trying for a US SIM got stuck at registration (${a(POST_JASON, "post, in Chinese")}).`,
    "You finally have a US number, link it, and some apps still won't send a code, and you can't tell whether it's the number or your phone.",
  ],
  vsH: "How it differs from a code-receiving site",
  vsP: "A code-receiving site rents you a number. A Saily number is yours. That's what matters for any account you'll keep using and may need to recover later.",
  vsHead: ["", "Code-receiving site", "Saily US number"],
  VS: [
    ["Whose number is it", "The site's. Before long, the same number receives codes for someone else", `As long as your service is active, it's assigned to you alone (${a(doc("otp"), "Help Center")})`],
    ["Can you still get codes in six months", "Usually not. The number has long since gone to someone else", `Yes, while it renews. If it lapses, it's held for 30 days so you can get it back (${a(doc("keep"), "Help Center")})`],
    ["What you need", "No ID, pay per code", "An identity check, a renewing subscription, and a device that can take an eSIM"],
  ],
  routeH: "From buying the number to getting codes, in six steps",
  routeP: "Go in order. Each step links to the page that covers it in detail. It's all done on the website and in the Saily app, and you don't need to travel.",
  routeLabel: "Getting a US number: 6 steps",
  codesH: "Straight answers: which codes arrive",
  codesP: "It's a real US number, but the carrier behind it runs on internet calling (VoIP), so some services that check number types see it as VoIP and won't send a code. Saily says so itself. From most to least certain:",
  CODES: [
    ["Saily's list: usually works", `One-time codes: WhatsApp, Signal, Viber, Airbnb. Two-step codes: PayPal, Wise, Venmo and others. The list isn't complete and isn't a promise (${a(doc("otp"), "Saily's list")})`],
    ["User tests: mixed", `Telegram, X, Google, Apple ID, ChatGPT and others. The same app works for some people and not others. See ${a(L("/howto/number-apps/"), "Which apps take the US number")}`],
    ["In mainland China", `A user got codes there over a local roaming network (${a(POST_JASON, "post, in Chinese")}), but mainland China isn't on Saily's English list of places where calls work, so calls may not`],
    ["Don't count on it", "Banks, brokers and similar financial services: Saily says some don't accept numbers like this. The number doesn't give you a US identity either, and this site doesn't cover opening accounts with it"],
  ],
  fitH: "Is it for you?", yesH: "Yes, if", noH: "Not yet, if",
  YES: ["You need a number that gets text codes to sign up for or log in to apps", "The accounts are for keeps, and you want a number that's yours alone and keeps renewing", "You can verify your identity with valid ID. Chinese-issued IDs need both a passport and an ID card", "Your phone supports eSIM, or you're happy to add a physical card that holds eSIMs"],
  NO: ["You want it for verification on US bank, brokerage or payment accounts", "You need MMS or call forwarding, which the number doesn't support", "Your ID is from a country Saily can't verify yet, such as Russia, Iran or North Korea", "You don't want a renewing subscription. The number only stays yours while it renews"],
  tracksH: "What else this site covers",
  tracksP: "Besides the number, Saily's main business is data for trips abroad. The full guide covers it for when you need it.",
  TRACKS: [
    ["PhoneCall", "The +1 US number", "What ID the check needs, what to do when codes don't arrive, why answering calls uses minutes, why texts should be plain, and how to keep or change the number.", [5]],
    ["Smartphone", "A phone without eSIM", "Many phones sold in mainland China have no eSIM. Saily's answer is a physical card that holds eSIMs: it goes in your SIM slot, and you install Saily onto it.", [6]],
    ["Globe", "Data abroad", "Buy a data plan for where you're going, install it, and it works when you land. If it's your first time, the three beginner lessons take you all the way.", [0, 1, 2, 3, 4, 7]],
  ],
  lessonsLink: "Data abroad: three beginner lessons",
  tracksLabel: "Matching steps in the full guide",
  stepLink: (n, title) => `Step ${n}: ${title}`,
};

const C = lang === "en" ? EN : ZH;
const headings = [["h-pain", C.painH], ["h-vs", C.vsH], ["h-route", C.routeH], ["h-codes", C.codesH], ["h-fit", C.fitH], ["h-tracks", C.tracksH]].map(([slug, text]) => ({ slug, text, depth: 2 }));
---
<Site title={C.brand} headings={headings}>
  <div class="home">
    <h1>{C.h1}</h1>
    <p class="home__lead">{C.lead[0]}<mark>{C.lead[1]}</mark>{C.lead[2]}</p>
    <div class="home__cta">
      <a class="xxd-btn" data-variant="primary" href={L("/quick-number/")}>{C.cta[0]}<i data-xxd-icon="ArrowRight" data-size="16"></i></a>
      <a class="xxd-btn" data-variant="ghost" href={stepHref(STEPS[5], lang)}>{C.cta[1]}</a>
    </div>
    <p class="home__note">{C.ctaNote}</p>

    <section aria-labelledby="h-pain">
      <h2 id="h-pain">{C.painH}</h2>
      <ul class="pain">{C.PAIN.map((x) => <li set:html={x} />)}</ul>
    </section>

    <section aria-labelledby="h-vs">
      <h2 id="h-vs">{C.vsH}</h2>
      <p>{C.vsP}</p>
      <div class="xxd-table-wrap lookup lookup--vs">
        <table class="xxd-table">
          <thead><tr>{C.vsHead.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>{C.VS.map(([h, them, us]) => <tr><th scope="row">{h}</th><td class="vs__them">{them}</td><td set:html={us} /></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="h-route">
      <h2 id="h-route">{C.routeH}</h2>
      <p>{C.routeP}</p>
      <ol class="xxd-steps roadmap" data-vertical aria-label={C.routeLabel}>
        {ROUTE.map((r) => (
          <li class="xxd-steps__item">
            <span class="xxd-steps__mark" aria-hidden="true">{r.n}</span>
            <span class="xxd-steps__text">
              <a class="xxd-steps__title xxd-steps__link" href={routeHref(r, lang)}>{t(r, "title", lang)}</a>
              <span class="xxd-steps__desc">{t(r, "sum", lang)}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="h-codes">
      <h2 id="h-codes">{C.codesH}</h2>
      <p>{C.codesP}</p>
      <div class="xxd-table-wrap lookup lookup--two">
        <table class="xxd-table">
          <tbody>{C.CODES.map(([h, d]) => <tr><th scope="row">{h}</th><td set:html={d} /></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="h-fit">
      <h2 id="h-fit">{C.fitH}</h2>
      <div class="fit">
        <div class="route"><h3><i data-xxd-icon="CircleCheck" data-size="18"></i>{C.yesH}</h3><ul>{C.YES.map((x) => <li>{x}</li>)}</ul></div>
        <div class="route"><h3><i data-xxd-icon="CircleX" data-size="18"></i>{C.noH}</h3><ul>{C.NO.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </section>

    <section aria-labelledby="h-tracks">
      <h2 id="h-tracks">{C.tracksH}</h2>
      <p>{C.tracksP}</p>
      <div class="flow">
        {C.TRACKS.map(([icon, h, p, steps], i) => (
          <div class="flow__box" data-mine={i === 0 ? "" : undefined}>
            <i class="flow__icon" data-xxd-icon={icon} data-size="20"></i>
            <p class="flow__title">{h}</p>
            <p class="flow__desc">{p}</p>
            <ul class="flow__how" aria-label={C.tracksLabel}>
              {icon === "Globe" && <li><a href={lessonHref(LESSONS[0], lang)}>{C.lessonsLink}</a></li>}
              {(steps as number[]).map((n) => STEPS.find((s) => s.n === n)!).map((s) => <li><a href={stepHref(s, lang)}>{C.stepLink(s.n, t(s, "title", lang))}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <Contact />
  </div>
</Site>
